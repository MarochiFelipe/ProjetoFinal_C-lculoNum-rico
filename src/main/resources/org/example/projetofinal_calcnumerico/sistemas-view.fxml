<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.projetofinal_calcnumerico.controller.SistemasController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox spacing="12">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Matriz A (uma linha por equação)"/>
            <TextArea fx:id="campoMatrizA" prefRowCount="4" promptText="Ex.: 3 2 4"
                      style="-fx-font-family: monospace;"/>
        </VBox>
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Vetor b (termos independentes)"/>
            <TextArea fx:id="campoVetorB" prefRowCount="4" promptText="Ex.: 1 2 3"
                      style="-fx-font-family: monospace;"/>
        </VBox>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Método"/>
        <ComboBox fx:id="seletorMetodoSistemas" prefWidth="220"/>
        <Button fx:id="botaoCalcular" text="Calcular" onAction="#calcular"/>
    </HBox>
    <HBox fx:id="grupoGaussSeidel" spacing="12">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Vetor inicial x₀"/>
            <TextField fx:id="campoVetorInicial" promptText="Ex.: 0 0 0"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Tolerância do erro relativo"/>
            <TextField fx:id="campoToleranciaSeidel" promptText="Ex.: 0,05"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Máximo de iterações"/>
            <TextField fx:id="campoMaxIteracoesSeidel" promptText="Ex.: 100"/>
        </VBox>
    </HBox>

    <TextArea fx:id="areaResultado" editable="false" wrapText="false"
              prefRowCount="6" VBox.vgrow="ALWAYS"
              style="-fx-font-family: monospace;"/>
</VBox>
