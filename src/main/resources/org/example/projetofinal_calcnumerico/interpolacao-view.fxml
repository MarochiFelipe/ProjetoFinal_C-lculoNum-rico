<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.projetofinal_calcnumerico.controller.InterpolacaoController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Interpolação Polinomial" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    <Label text="Informe os pontos conhecidos separando os números por espaço ou ponto e vírgula (aceita ponto ou vírgula decimal)."
           wrapText="true" style="-fx-text-fill: #555555;"/>

    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="150"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Valores de x:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtX" promptText="Ex.: 0 1 3 4"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Valores de f(x):" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtY" promptText="Ex.: -5 1 25 55"
                   GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Valor de x a interpolar:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="txtXAlvo" promptText="Ex.: 0.5"
                   GridPane.columnIndex="1" GridPane.rowIndex="2"/>
    </GridPane>

    <HBox spacing="10">
        <Button text="Calcular (Lagrange)" onAction="#onCalcularLagrange"/>
        <Button text="Calcular (Newton)" onAction="#onCalcularNewton"/>
        <Button text="Limpar" onAction="#onLimpar"/>
    </HBox>

    <Separator/>

    <Label fx:id="lblStatus" wrapText="true" style="-fx-font-weight: bold;"/>

    <TextArea fx:id="txtResultado" editable="false" VBox.vgrow="ALWAYS"
              promptText="O resultado final e os valores intermediários aparecerão aqui."
              style="-fx-font-family: 'Monospaced'; -fx-font-size: 13px;"/>
</VBox>