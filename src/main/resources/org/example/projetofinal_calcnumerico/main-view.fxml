<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.projetofinal_calcnumerico.controller.MainController">
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab text="Raízes de Funções">
                    <fx:include source="raizes-view.fxml"/>
                </Tab>
                <Tab text="Sistemas Lineares">
                    <fx:include source="sistemas-view.fxml"/>
                </Tab>
                <Tab text="Interpolação">
                    <fx:include source="interpolacao-view.fxml"/>
                </Tab>
                <Tab text="Integração Numérica">
                    <fx:include source="integracao-view.fxml"/>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>